    "Threek lives in the menu bar. Click it to turn Threek off or change its settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد Threek في شريط القوائم. انقر عليه لإيقاف Threek أو تغيير إعداداته."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek е в лентата с менюта. Щракнете върху него, за да го изключите или да промените настройките му."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek najdete na řádku nabídek. Kliknutím ho můžete vypnout nebo změnit jeho nastavení."
          }
        },
        "da": {
