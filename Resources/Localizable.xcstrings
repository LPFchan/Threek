    "Media keys not working — re-grant Accessibility": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفاتيح الوسائط لا تعمل — امنح إذن تسهيلات الاستخدام مجددًا"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Медийните клавиши не работят — разрешете отново Достъпност"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediální klávesy nefungují — znovu udělte přístup k Zpřístupnění"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Medietasterne virker ikke — giv adgang til Tilgængelighed igen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Medientasten funktionieren nicht – Bedienungshilfen erneut erlauben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas multimedia no funcionan: vuelve a conceder Accesibilidad"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Meediaklahvid ei tööta — luba hõlbustusfunktsioonid uuesti"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediapainikkeet eivät toimi – salli Käyttöapu uudelleen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches multimédias ne fonctionnent pas — réautorisez l’Accessibilité"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मीडिया कुंजियाँ काम नहीं कर रहीं — एक्सेसिबिलिटी की अनुमति फिर से दें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Medijske tipke ne rade — ponovno dopustite pristupačnost"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A médiabillentyűk nem működnek – engedélyezze újra a Kisegítő lehetőségeket"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tasti multimediali non funzionano: consenti di nuovo Accessibilità"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メディアキーが機能していません — アクセシビリティを再許可してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미디어 키가 작동하지 않음 — 손쉬운 사용 권한을 다시 허용하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Medietastene virker ikke – gi tilgang til Tilgjengelighet på nytt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediatoetsen werken niet — geef opnieuw toegang tot Toegankelijkheid"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawisze multimedialne nie działają — ponownie przyznaj dostęp do Dostępności"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas de mídia não funcionam — conceda Acessibilidade novamente"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas multimédia não funcionam — volte a conceder Acessibilidade"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastele media nu funcționează — acordă din nou Accesibilitate"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медиаклавиши не работают — снова разрешите Универсальный доступ"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediálne klávesy nefungujú — znova udeľte prístup k Prístupnosti"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Medietangenterna fungerar inte – ge åtkomst till Hjälpmedel igen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Medya tuşları çalışmıyor — Erişilebilirlik iznini yeniden verin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Медіаклавіші не працюють — знову надайте доступ до Параметрів доступності"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phím phương tiện không hoạt động — hãy cấp lại quyền Trợ năng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "媒体键无法使用 — 请重新授予辅助功能权限"
          }
        }
      }
    },
    "No supported media apps found. macOS will ask when Threek first controls one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على تطبيقات وسائط مدعومة. سيسأل macOS عندما يتحكم Threek في أحدها لأول مرة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не са намерени поддържани мултимедийни приложения. macOS ще попита, когато Threek управлява такова за първи път."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebyly nalezeny žádné podporované multimediální aplikace. macOS se zeptá, až Threek nějakou poprvé ovládne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet nogen understøttede medieapps. macOS spørger, første gang Threek styrer en."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine unterstützten Medien-Apps gefunden. macOS fragt, wenn Threek zum ersten Mal eine steuert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron apps multimedia compatibles. macOS preguntará cuando Threek controle una por primera vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Toetatud meediarakendusi ei leitud. macOS küsib, kui Threek esimest korda mõnda juhib."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuettuja media-appeja ei löytynyt. macOS kysyy, kun Threek ohjaa jotakin ensimmäistä kertaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app multimédia compatible trouvée. macOS demandera quand Threek en contrôlera une pour la première fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई समर्थित मीडिया ऐप नहीं मिला। जब Threek पहली बार किसी को नियंत्रित करेगा, तब macOS पूछेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije pronađena nijedna podržana medijska aplikacija. macOS će pitati kad Threek prvi put upravlja nekom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem található támogatott médiaapp. A macOS akkor kérdez, amikor a Threek először vezérel egyet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna app multimediale supportata trovata. macOS chiederà quando Threek ne controllerà una la prima volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応するメディアアプリが見つかりません。Threek が初めてアプリを操作するときに macOS が確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되는 미디어 앱을 찾지 못했습니다. Threek이 처음 앱을 제어할 때 macOS가 묻습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ingen støttede medieapper. macOS spør første gang Threek styrer en."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen ondersteunde media-apps gevonden. macOS vraagt het als Threek er voor het eerst een bedient."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono obsługiwanych aplikacji multimedialnych. macOS zapyta, gdy Threek pierwszy raz którąś sterować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum app de mídia compatível encontrado. O macOS vai perguntar quando o Threek controlar um pela primeira vez."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma app multimédia compatível encontrada. O macOS vai perguntar quando o Threek controlar uma pela primeira vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-au găsit aplicații media compatibile. macOS va întreba când Threek va controla una prima dată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживаемые медиаприложения не найдены. macOS спросит, когда Threek впервые будет управлять одним из них."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenašli sa žiadne podporované multimediálne aplikácie. macOS sa opýta, keď Threek prvýkrát nejakú ovláda."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga appar som stöds hittades. macOS frågar första gången Threek styr en."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenen medya uygulaması bulunamadı. Threek birini ilk kez kontrol ettiğinde macOS soracak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтримуваних медіазастосунків не знайдено. macOS запитає, коли Threek уперше керуватиме одним із них."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy ứng dụng phương tiện nào được hỗ trợ. macOS sẽ hỏi khi Threek điều khiển một ứng dụng lần đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到支持的媒体 App。Threek 首次控制某个 App 时，macOS 会询问。"
          }
        }
      }
    },
