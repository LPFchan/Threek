    "Choose which app your media keys control, right from the keyboard.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر التطبيق الذي تتحكم فيه مفاتيح الوسائط، مباشرة من لوحة المفاتيح."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете кое приложение да управляват мултимедийните клавиши – направо от клавиатурата."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, kterou aplikaci budou ovládat multimediální klávesy – přímo z klávesnice."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, hvilken app dine medietaster styrer – direkte fra tastaturet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle direkt auf der Tastatur, welche App deine Medientasten steuern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué app controlan tus teclas multimedia, directamente desde el teclado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali otse klaviatuurilt, millist rakendust meediaklahvid juhivad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse suoraan näppäimistöltä, mitä appia mediapainikkeet ohjaavat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l’app que contrôlent vos touches multimédia, directement depuis le clavier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीबोर्ड से ही चुनें कि आपकी मीडिया कुंजियाँ किस ऐप को नियंत्रित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite koju aplikaciju kontroliraju medijske tipke, izravno s tipkovnice."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki közvetlenül a billentyűzetről, melyik appot vezéreljék a médiagombok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quale app controllano i tasti multimediali, direttamente dalla tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メディアキーで操作するアプリを、キーボードから直接選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드에서 바로 미디어 키가 제어할 앱을 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg hvilken app medietastene styrer, rett fra tastaturet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies direct vanaf het toetsenbord welke app je mediatoetsen bedienen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz prosto z klawiatury, którą aplikacją sterują klawisze multimedialne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha qual app suas teclas de mídia controlam, direto do teclado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a app que as teclas multimédia controlam, diretamente no teclado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege ce aplicație controlează tastele media, direct de pe tastatură."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирайте, каким приложением управляют медиаклавиши, прямо с клавиатуры."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte priamo z klávesnice, ktorú aplikáciu budú ovládať multimediálne klávesy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj vilken app medietangenterna styr, direkt från tangentbordet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Medya tuşlarınızın hangi uygulamayı kontrol edeceğini doğrudan klavyeden seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обирайте просто з клавіатури, яким застосунком керують медіаклавіші."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ứng dụng mà các phím phương tiện điều khiển, ngay từ bàn phím."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接在键盘上选择媒体键要控制的 App。"
          }
        }
      }
    },
