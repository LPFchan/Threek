        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi có nhiều ứng dụng đang phát, ⏯ hiển thị từng ứng dụng phía trên phím F để chọn nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多个 App 同时播放时，按 ⏯ 会把每个 App 显示在选中它的 F 键上方。"
          }
        }
      }
