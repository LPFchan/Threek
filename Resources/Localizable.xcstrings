    "Accessibility is off — media keys aren’t caught": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسهيلات الاستخدام متوقفة — لا تُلتقط مفاتيح الوسائط"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Достъпността е изключена — мултимедийните клавиши не се прихващат"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zpřístupnění je vypnuté — multimediální klávesy se nezachytávají"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgængelighed er slået fra — medietaster fanges ikke"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen sind aus – Medientasten werden nicht abgefangen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesibilidad desactivada: las teclas multimedia no se captan"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hõlbustus on väljas — meediaklahve ei püüta"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttöapu ei ole päällä – mediapainikkeita ei siepata"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibilité désactivée — les touches multimédia ne sont pas interceptées"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐक्सेसिबिलिटी बंद है — मीडिया कुंजियाँ नहीं पकड़ी जा रहीं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristupačnost je isključena — medijske tipke se ne hvataju"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kisegítő lehetőségek ki vannak kapcsolva – a médiagombokat nem kapja el"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibilità disattivata: i tasti multimediali non vengono intercettati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティがオフです — メディアキーを受け取れません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용이 꺼져 있음 — 미디어 키를 받지 못함"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgjengelighet er av – medietaster fanges ikke opp"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegankelijkheid staat uit – mediatoetsen worden niet opgevangen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostępność wyłączona — klawisze multimedialne nie są przechwytywane"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acessibilidade desativada — as teclas de mídia não são capturadas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Acessibilidade desativada — as teclas multimédia não são captadas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesibilitatea este dezactivată — tastele media nu sunt preluate"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Универсальный доступ выключен — медиаклавиши не перехватываются"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prístupnosť je vypnutá — multimediálne klávesy sa nezachytávajú"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjälpmedel är avstängt – medietangenterna fångas inte upp"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik kapalı — medya tuşları yakalanmıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступність вимкнено — медіаклавіші не перехоплюються"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trợ năng đang tắt — không nhận được phím phương tiện"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“辅助功能”已关闭 — 无法接收媒体键"
          }
        }
      }
    },
