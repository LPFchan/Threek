            "value": "Threek asub menüüribal. Klõpsa seda, et Threek välja lülitada või seadeid muuta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek asuu valikkorivillä. Klikkaa sitä sammuttaaksesi Threekin tai muuttaaksesi sen asetuksia."
          }
        },
        "fr": {
