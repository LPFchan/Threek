        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek lebt in der Menüleiste. Klicke darauf, um Threek auszuschalten oder die Einstellungen zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek vive en la barra de menús. Haz clic en él para desactivarlo o cambiar sus ajustes."
          }
        },
        "et": {
