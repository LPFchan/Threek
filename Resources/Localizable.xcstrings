        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Медийните клавиши не работят — разрешете отново Достъпност"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediální klávesy nefungují — znovu udělte přístup k Zpřístupnění"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Medietasterne virker ikke — giv adgang til Tilgængelighed igen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Medientasten funktionieren nicht – Bedienungshilfen erneut erlauben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas multimedia no funcionan: vuelve a conceder Accesibilidad"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Meediaklahvid ei tööta — luba hõlbustusfunktsioonid uuesti"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediapainikkeet eivät toimi – salli Käyttöapu uudelleen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches multimédias ne fonctionnent pas — réautorisez l’Accessibilité"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मीडिया कुंजियाँ काम नहीं कर रहीं — एक्सेसिबिलिटी की अनुमति फिर से दें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Medijske tipke ne rade — ponovno dopustite pristupačnost"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A médiabillentyűk nem működnek – engedélyezze újra a Kisegítő lehetőségeket"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tasti multimediali non funzionano: consenti di nuovo Accessibilità"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メディアキーが機能していません — アクセシビリティを再許可してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미디어 키가 작동하지 않음 — 손쉬운 사용 권한을 다시 허용하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Medietastene virker ikke – gi tilgang til Tilgjengelighet på nytt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediatoetsen werken niet — geef opnieuw toegang tot Toegankelijkheid"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawisze multimedialne nie działają — ponownie przyznaj dostęp do Dostępności"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas de mídia não funcionam — conceda Acessibilidade novamente"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas multimédia não funcionam — volte a conceder Acessibilidade"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastele media nu funcționează — acordă din nou Accesibilitate"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медиаклавиши не работают — снова разрешите Универсальный доступ"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediálne klávesy nefungujú — znova udeľte prístup k Prístupnosti"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Medietangenterna fungerar inte – ge åtkomst till Hjälpmedel igen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Medya tuşları çalışmıyor — Erişilebilirlik iznini yeniden verin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Медіаклавіші не працюють — знову надайте доступ до Параметрів доступності"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phím phương tiện không hoạt động — hãy cấp lại quyền Trợ năng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "媒体键无法使用 — 请重新授予辅助功能权限"
          }
        }
      }
    },
