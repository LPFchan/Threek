    "Threek looks at the part of the screen behind its HUD to pick white or black text you can read. Nothing is recorded or saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص Threek جزء الشاشة خلف الواجهة ليختار نصًا أبيض أو أسود يسهل قراءته. لا يُسجَّل أي شيء ولا يُحفظ."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek гледа частта от екрана зад панела, за да избере бял или черен текст, който се чете. Нищо не се записва и не се пази."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek se dívá na část obrazovky za panelem, aby vybral bílý nebo černý text, který přečtete. Nic se nenahrává ani neukládá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek kigger på den del af skærmen, der ligger bag HUD’en, for at vælge hvid eller sort tekst, du kan læse. Intet optages eller gemmes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek schaut auf den Bildschirmbereich hinter dem HUD, um lesbaren weißen oder schwarzen Text zu wählen. Nichts wird aufgenommen oder gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek mira la parte de la pantalla detrás del HUD para elegir texto blanco o negro legible. No se graba ni se guarda nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek vaatab paneeli taga olevat ekraaniosa, et valida loetav valge või must tekst. Midagi ei salvestata."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek katsoo HUD:n takana olevaa näytön osaa valitakseen luettavan valkoisen tai mustan tekstin. Mitään ei tallenneta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek regarde la partie de l’écran derrière le HUD pour choisir un texte blanc ou noir lisible. Rien n’est enregistré ni conservé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek HUD के पीछे की स्क्रीन देखकर पढ़ने लायक सफ़ेद या काला टेक्स्ट चुनता है। कुछ भी रिकॉर्ड या सेव नहीं होता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek gleda dio zaslona iza HUD-a kako bi odabrao bijeli ili crni tekst koji se može čitati. Ništa se ne snima niti sprema."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Threek megnézi a képernyő HUD mögötti részét, hogy olvasható fehér vagy fekete szöveget válasszon. Semmit sem rögzít vagy ment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek guarda la parte dello schermo dietro l’HUD per scegliere un testo bianco o nero leggibile. Non viene registrato né salvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek は HUD の背後にある画面の一部を見て、読みやすい白または黒の文字を選びます。何も録画・保存しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek은 HUD 뒤의 화면 일부를 보고 읽기 쉬운 흰색 또는 검은색 글자를 고릅니다. 아무것도 녹화하거나 저장하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek ser på delen av skjermen bak HUD-en for å velge hvit eller svart tekst som er lett å lese. Ingenting tas opp eller lagres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek kijkt naar het deel van het scherm achter de HUD om leesbare witte of zwarte tekst te kiezen. Er wordt niets opgenomen of bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek patrzy na fragment ekranu za HUD-em, by wybrać czytelny biały lub czarny tekst. Nic nie jest nagrywane ani zapisywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Threek olha a parte da tela atrás do HUD para escolher texto branco ou preto legível. Nada é gravado ou salvo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Threek observa a parte do ecrã por trás do HUD para escolher texto branco ou preto legível. Nada é gravado nem guardado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek se uită la partea de ecran din spatele HUD-ului ca să aleagă text alb sau negru lizibil. Nimic nu se înregistrează sau salvează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek смотрит на часть экрана за панелью, чтобы выбрать читаемый белый или чёрный текст. Ничего не записывается и не сохраняется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek sa pozerá na časť obrazovky za panelom, aby vybral biely alebo čierny text, ktorý sa dá čítať. Nič sa nenahráva ani neukladá."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek tittar på den del av skärmen som ligger bakom HUD:en för att välja läsbar vit eller svart text. Inget spelas in eller sparas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek, okunabilir beyaz veya siyah metni seçmek için HUD’un arkasındaki ekran bölümüne bakar. Hiçbir şey kaydedilmez veya saklanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek дивиться на частину екрана за панеллю, щоб вибрати читабельний білий чи чорний текст. Нічого не записується і не зберігається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek xem phần màn hình phía sau HUD để chọn chữ trắng hoặc đen dễ đọc. Không có gì được ghi lại hay lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek 会查看 HUD 后面的屏幕区域，以选择易读的白色或黑色文字。不会录制或保存任何内容。"
          }
        }
      }
    },
    "Threek needs Accessibility access to catch ⏯, ⏮ and ⏭ before macOS sends them to an app. It ignores every other key.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Threek إلى إذن تسهيلات الاستخدام لالتقاط ⏯ و⏮ و⏭ قبل أن يرسلها macOS إلى أي تطبيق. ويتجاهل كل المفاتيح الأخرى."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek се нуждае от достъп до „Достъпност“, за да прихваща ⏯, ⏮ и ⏭, преди macOS да ги изпрати към приложение. Всички други клавиши се пренебрегват."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek potřebuje přístup ke Zpřístupnění, aby zachytil ⏯, ⏮ a ⏭ dřív, než je macOS pošle aplikaci. Všechny ostatní klávesy ignoruje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek skal have adgang til Tilgængelighed for at fange ⏯, ⏮ og ⏭, før macOS sender dem til en app. Alle andre taster ignoreres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek braucht Zugriff auf die Bedienungshilfen, um ⏯, ⏮ und ⏭ abzufangen, bevor macOS sie an eine App weitergibt. Alle anderen Tasten ignoriert Threek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek necesita acceso de Accesibilidad para captar ⏯, ⏮ y ⏭ antes de que macOS los envíe a una app. Ignora todas las demás teclas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek vajab juurdepääsu hõlbustusfunktsioonidele, et püüda ⏯, ⏮ ja ⏭ enne, kui macOS need rakendusele saadab. Kõiki teisi klahve eiratakse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek tarvitsee Käyttöapu-oikeuden siepatakseen ⏯, ⏮ ja ⏭ ennen kuin macOS lähettää ne apille. Kaikki muut näppäimet se ohittaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek a besoin de l’accès à l’Accessibilité pour intercepter ⏯, ⏮ et ⏭ avant que macOS ne les envoie à une app. Toutes les autres touches sont ignorées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS द्वारा किसी ऐप को भेजने से पहले ⏯, ⏮ और ⏭ पकड़ने के लिए Threek को ऐक्सेसिबिलिटी की अनुमति चाहिए। बाकी सभी कुंजियों को यह अनदेखा करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek treba pristup Pristupačnosti da uhvati ⏯, ⏮ i ⏭ prije nego što ih macOS pošalje aplikaciji. Sve ostale tipke zanemaruje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Threeknek Kisegítő lehetőségek hozzáférés kell, hogy elkapja a ⏯, ⏮ és ⏭ gombot, mielőtt a macOS továbbadja őket egy appnak. Minden más billentyűt figyelmen kívül hagy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek ha bisogno dell’accesso ad Accessibilità per intercettare ⏯, ⏮ e ⏭ prima che macOS li invii a un’app. Ignora tutti gli altri tasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS がアプリに送る前に ⏯・⏮・⏭ を受け取るため、Threek にはアクセシビリティの許可が必要です。ほかのキーはすべて無視します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 앱에 보내기 전에 ⏯, ⏮, ⏭를 받으려면 Threek에 손쉬운 사용 권한이 필요합니다. 다른 키는 모두 무시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek trenger tilgang til Tilgjengelighet for å fange ⏯, ⏮ og ⏭ før macOS sender dem til en app. Alle andre taster ignoreres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek heeft toegang tot Toegankelijkheid nodig om ⏯, ⏮ en ⏭ op te vangen voordat macOS ze naar een app stuurt. Alle andere toetsen negeert Threek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek potrzebuje dostępu do Dostępności, aby przechwycić ⏯, ⏮ i ⏭, zanim macOS wyśle je do aplikacji. Wszystkie inne klawisze ignoruje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Threek precisa de acesso à Acessibilidade para capturar ⏯, ⏮ e ⏭ antes que o macOS os envie a um app. Todas as outras teclas são ignoradas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Threek precisa de acesso à Acessibilidade para captar ⏯, ⏮ e ⏭ antes de o macOS os enviar para uma app. Todas as outras teclas são ignoradas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek are nevoie de acces la Accesibilitate ca să preia ⏯, ⏮ și ⏭ înainte ca macOS să le trimită unei aplicații. Toate celelalte taste sunt ignorate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek нужен универсальный доступ, чтобы перехватывать ⏯, ⏮ и ⏭ до того, как macOS передаст их приложению. Остальные клавиши он игнорирует."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek potrebuje prístup k Prístupnosti, aby zachytil ⏯, ⏮ a ⏭ skôr, než ich macOS pošle aplikácii. Všetky ostatné klávesy ignoruje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek behöver åtkomst till Hjälpmedel för att fånga ⏯, ⏮ och ⏭ innan macOS skickar dem till en app. Alla andra tangenter ignoreras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek’in ⏯, ⏮ ve ⏭ tuşlarını macOS bir uygulamaya göndermeden önce yakalaması için Erişilebilirlik izni gerekir. Diğer tüm tuşları yok sayar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek потрібен доступ до Доступності, щоб перехоплювати ⏯, ⏮ і ⏭, перш ніж macOS надішле їх застосунку. Усі інші клавіші він ігнорує."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek cần quyền Trợ năng để nhận ⏯, ⏮ và ⏭ trước khi macOS gửi chúng đến một ứng dụng. Mọi phím khác đều được bỏ qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek 需要“辅助功能”权限，才能在 macOS 把 ⏯、⏮ 和 ⏭ 发给 App 之前接收它们。其他按键一律忽略。"
          }
        }
      }
    },
    "Threek sends play and pause to the app you pick. macOS asks once for each app; Threek opens any that aren't running in the background just long enough to ask.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل Threek أمري التشغيل والإيقاف المؤقت إلى التطبيق الذي تختاره. يسأل macOS مرة واحدة لكل تطبيق؛ ويفتح Threek أي تطبيق غير مشغّل في الخلفية لمدة تكفي للسؤال فقط."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek изпраща пускане и пауза към приложението, което изберете. macOS пита веднъж за всяко приложение; Threek отваря неработещите на заден план само колкото да се зададе въпросът."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek posílá přehrát a pozastavit do aplikace, kterou vyberete. macOS se ptá jednou pro každou aplikaci; Threek otevře ty, které neběží, na pozadí jen na dobu dotazu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek sender afspil og pause til den app, du vælger. macOS spørger én gang for hver app; Threek åbner dem, der ikke kører, i baggrunden lige længe nok til at spørge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek sendet Wiedergabe und Pause an die App, die du wählst. macOS fragt einmal pro App; Apps, die nicht laufen, öffnet Threek kurz im Hintergrund, nur für die Frage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek envía reproducir y pausa a la app que elijas. macOS pregunta una vez por cada app; Threek abre en segundo plano las que no estén abiertas, solo el tiempo de preguntar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek saadab esitamise ja pausi valitud rakendusele. macOS küsib iga rakenduse kohta ühe korra; mittetöötavad rakendused avab Threek taustal vaid küsimise ajaks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek lähettää toiston ja tauon valitsemaasi appiin. macOS kysyy kerran kustakin apista; Threek avaa käynnissä olemattomat taustalle vain kysymisen ajaksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek envoie lecture et pause à l’app que vous choisissez. macOS demande une fois par app ; Threek ouvre en arrière-plan celles qui ne tournent pas, le temps de la question."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek आपके चुने ऐप को चलाओ और रोको भेजता है। macOS हर ऐप के लिए एक बार पूछता है; जो ऐप नहीं चल रहे, उन्हें Threek पूछने भर के लिए बैकग्राउंड में खोलता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek šalje reprodukciju i pauzu aplikaciji koju odaberete. macOS pita jednom za svaku aplikaciju; one koje nisu pokrenute Threek otvara u pozadini samo dok se ne pita."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Threek lejátszást és szünetet küld a választott appnak. A macOS minden appnál egyszer kérdez; a nem futó appokat a Threek csak a kérdés idejére nyitja meg a háttérben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek invia riproduci e pausa all’app che scegli. macOS chiede una volta per ogni app; Threek apre in background quelle non aperte, solo il tempo di chiedere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek は選んだアプリに再生と一時停止を送ります。macOS はアプリごとに一度だけ確認します。起動していないアプリは、確認のあいだだけ Threek がバックグラウンドで開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek은 선택한 앱에 재생과 일시 정지를 보냅니다. macOS는 앱마다 한 번씩 묻고, 실행 중이 아닌 앱은 Threek이 물어보는 동안만 백그라운드에서 엽니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek sender spill av og pause til appen du velger. macOS spør én gang for hver app; Threek åpner de som ikke kjører i bakgrunnen, bare lenge nok til å spørre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek stuurt afspelen en pauzeren naar de app die je kiest. macOS vraagt het één keer per app; apps die niet draaien opent Threek op de achtergrond, net lang genoeg om te vragen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek wysyła odtwarzanie i pauzę do wybranej aplikacji. macOS pyta raz o każdą aplikację; te, które nie działają, Threek otwiera w tle tylko na czas pytania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Threek envia reproduzir e pausar ao app que você escolher. O macOS pergunta uma vez por app; os que não estão abertos o Threek abre em segundo plano só pelo tempo da pergunta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Threek envia reproduzir e pausa para a app que escolher. O macOS pergunta uma vez por app; as que não estão abertas o Threek abre em segundo plano só o tempo da pergunta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek trimite redare și pauză aplicației alese. macOS întreabă o dată pentru fiecare aplicație; pe cele care nu rulează, Threek le deschide în fundal doar cât durează întrebarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek отправляет воспроизведение и паузу выбранному приложению. macOS спрашивает один раз для каждого приложения; незапущенные Threek открывает в фоне только на время вопроса."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek posiela prehrať a pozastaviť do aplikácie, ktorú vyberiete. macOS sa pýta raz pre každú aplikáciu; tie, ktoré nebežia, Threek otvorí na pozadí len na čas otázky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek skickar spela upp och paus till appen du väljer. macOS frågar en gång per app; appar som inte är igång öppnar Threek i bakgrunden bara så länge frågan tar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek seçtiğiniz uygulamaya oynat ve duraklat gönderir. macOS her uygulama için bir kez sorar; çalışmayanları Threek yalnızca sormak için arka planda kısa süre açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek надсилає відтворення й паузу вибраному застосунку. macOS питає один раз для кожного застосунку; незапущені Threek відкриває у фоні лише на час запитання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek gửi phát và tạm dừng đến ứng dụng bạn chọn. macOS hỏi một lần cho mỗi ứng dụng; ứng dụng nào chưa chạy thì Threek mở ở chế độ nền đủ lâu để hỏi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Threek 会把播放和暂停发给你选的 App。macOS 会为每个 App 询问一次；未运行的 App，Threek 会在后台打开，只停留到询问完成。"
          }
        }
      }
    },
    "Turn on Threek in the list, then come back here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل Threek في القائمة، ثم عُد إلى هنا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Включете Threek в списъка и се върнете тук."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte Threek v seznamu a vraťte se sem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Threek til på listen, og vend så tilbage hertil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Threek in der Liste und komm dann hierher zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Threek en la lista y vuelve aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita loendis Threek sisse ja tule siia tagasi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita Threek päälle luettelossa ja palaa sitten tänne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Threek dans la liste, puis revenez ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूची में Threek चालू करें, फिर यहाँ वापस आएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključite Threek na popisu, a zatim se vratite ovamo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be a Threeket a listában, majd gyere vissza ide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Threek nell’elenco, poi torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストで Threek をオンにしてから、ここに戻ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에서 Threek을 켠 다음 여기로 돌아오세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Threek i listen, og kom tilbake hit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet Threek aan in de lijst en kom dan hier terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Threek na liście, a potem wróć tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Threek na lista e volte aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Threek na lista e volte aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activează Threek în listă, apoi revino aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Threek в списке и вернитесь сюда."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite Threek v zozname a vráťte sa sem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Threek i listan och kom sedan tillbaka hit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listede Threek’i açın, sonra buraya dönün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть Threek у списку й поверніться сюди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Threek trong danh sách, rồi quay lại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在列表中打开 Threek，然后回到这里。"
          }
        }
      }
    },
    "Turn on Threek in the list. If macOS asks to quit and reopen Threek, go ahead; setup picks up where it left off.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل Threek في القائمة. إذا طلب macOS إنهاء Threek وإعادة فتحه، فوافق؛ سيكمل الإعداد من حيث توقف."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Включете Threek в списъка. Ако macOS поиска да затвори и отвори отново Threek, съгласете се; настройката продължава оттам, докъдето е стигнала."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte Threek v seznamu. Pokud macOS požádá o ukončení a znovuotevření Threeku, potvrďte to; nastavení bude pokračovat tam, kde skončilo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Threek til på listen. Hvis macOS beder om at afslutte og genåbne Threek, så gør det; opsætningen fortsætter, hvor den slap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Threek in der Liste. Wenn macOS anbietet, Threek zu beenden und neu zu öffnen, tu das; die Einrichtung macht dort weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Threek en la lista. Si macOS pide cerrar y volver a abrir Threek, acepta; la configuración seguirá donde se quedó."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita loendis Threek sisse. Kui macOS palub Threeki sulgeda ja uuesti avada, nõustu; seadistus jätkab samast kohast."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita Threek päälle luettelossa. Jos macOS pyytää lopettamaan ja avaamaan Threekin uudelleen, tee niin; käyttöönotto jatkuu siitä mihin jäi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Threek dans la liste. Si macOS propose de quitter et rouvrir Threek, acceptez ; la configuration reprendra là où elle s’était arrêtée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूची में Threek चालू करें। अगर macOS Threek को बंद करके फिर खोलने को कहे, तो कर दें; सेटअप वहीं से आगे बढ़ेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključite Threek na popisu. Ako macOS zatraži da zatvorite i ponovno otvorite Threek, prihvatite; postavljanje nastavlja gdje je stalo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be a Threeket a listában. Ha a macOS kéri a Threek bezárását és újranyitását, fogadd el; a beállítás ott folytatódik, ahol abbamaradt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Threek nell’elenco. Se macOS chiede di chiudere e riaprire Threek, accetta; la configurazione riprenderà da dove era rimasta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストで Threek をオンにしてください。macOS に Threek の終了と再起動を求められたら、そのまま進めてください。設定は途中から再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에서 Threek을 켜세요. macOS가 Threek을 종료하고 다시 열라고 하면 그대로 진행하세요. 설정은 멈춘 곳에서 이어집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Threek i listen. Hvis macOS ber om å avslutte og åpne Threek på nytt, gjør det; oppsettet fortsetter der det slapp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet Threek aan in de lijst. Vraagt macOS om Threek te stoppen en opnieuw te openen, doe dat dan; de installatie gaat verder waar hij was."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Threek na liście. Jeśli macOS poprosi o zamknięcie i ponowne otwarcie Threek, zgódź się; konfiguracja wznowi się w tym samym miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Threek na lista. Se o macOS pedir para encerrar e reabrir o Threek, aceite; a configuração continua de onde parou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Threek na lista. Se o macOS pedir para encerrar e reabrir o Threek, aceite; a configuração continua onde ficou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activează Threek în listă. Dacă macOS cere închiderea și redeschiderea Threek, acceptă; configurarea continuă de unde a rămas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Threek в списке. Если macOS предложит закрыть и снова открыть Threek, согласитесь: настройка продолжится с того же места."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite Threek v zozname. Ak macOS požiada o ukončenie a opätovné otvorenie Threeku, potvrďte to; nastavenie pokračuje tam, kde skončilo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Threek i listan. Om macOS ber dig avsluta och öppna Threek igen, gör det; konfigurationen fortsätter där den slutade."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listede Threek’i açın. macOS Threek’i kapatıp yeniden açmayı isterse kabul edin; kurulum kaldığı yerden devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть Threek у списку. Якщо macOS попросить закрити й знову відкрити Threek, погодьтеся: налаштування продовжиться з того ж місця."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Threek trong danh sách. Nếu macOS yêu cầu thoát và mở lại Threek, hãy đồng ý; phần thiết lập sẽ tiếp tục từ chỗ đang dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在列表中打开 Threek。如果 macOS 要求退出并重新打开 Threek，请照做；设置会从中断处继续。"
          }
        }
      }
    },
    "Turn on the apps you want Threek to control under Automation, then come back here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل التطبيقات التي تريد أن يتحكم فيها Threek ضمن الأتمتة، ثم عُد إلى هنا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Включете приложенията, които Threek да управлява, в „Автоматизация“ и се върнете тук."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V části Automatizace zapněte aplikace, které má Threek ovládat, a vraťte se sem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå de apps til under Automatisering, som Threek skal styre, og vend så tilbage hertil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere unter „Automation“ die Apps, die Threek steuern soll, und komm dann hierher zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa en Automatización las apps que quieres que Threek controle y vuelve aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita jaotises Automatiseerimine sisse rakendused, mida Threek peab juhtima, ja tule siia tagasi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita Automaatio-kohdassa päälle apit, joita Threekin halutaan ohjaavan, ja palaa sitten tänne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez sous Automatisation les apps que Threek doit contrôler, puis revenez ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑटोमेशन में वे ऐप चालू करें जिन्हें Threek नियंत्रित करे, फिर यहाँ वापस आएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U odjeljku Automatizacija uključite aplikacije kojima Threek treba upravljati, a zatim se vratite ovamo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Automatizálás részben kapcsold be azokat az appokat, amelyeket a Threek vezéreljen, majd gyere vissza ide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Automazione attiva le app che vuoi far controllare a Threek, poi torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オートメーションで Threek に操作させたいアプリをオンにしてから、ここに戻ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동화에서 Threek이 제어할 앱을 켠 다음 여기로 돌아오세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på appene du vil at Threek skal styre under Automatisering, og kom tilbake hit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet onder Automatisering de apps aan die Threek mag bedienen en kom dan hier terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W sekcji Automatyzacja włącz aplikacje, którymi ma sterować Threek, a potem wróć tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative em Automação os apps que o Threek deve controlar e volte aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative em Automação as apps que o Threek deve controlar e volte aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activează în Automatizare aplicațiile pe care vrei să le controleze Threek, apoi revino aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите в разделе «Автоматизация» приложения, которыми должен управлять Threek, и вернитесь сюда."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V časti Automatizácia zapnite aplikácie, ktoré má Threek ovládať, a vráťte sa sem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på apparna som Threek ska styra under Automatisering och kom sedan tillbaka hit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomasyon’da Threek’in kontrol etmesini istediğiniz uygulamaları açın, sonra buraya dönün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть у розділі «Автоматизація» застосунки, якими має керувати Threek, і поверніться сюди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật các ứng dụng bạn muốn Threek điều khiển trong mục Tự động hóa, rồi quay lại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“自动化”中打开你希望 Threek 控制的 App，然后回到这里。"
          }
        }
      }
    },
