    "Press ⏯ when more than one app is playing, then pick one with F7, F8 or F9. Hold ⏯ to pause everything.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ⏯ عند تشغيل أكثر من تطبيق، ثم اختر واحدًا بـ F7 أو F8 أو F9. اضغط مطولًا على ⏯ لإيقاف كل شيء مؤقتًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Натиснете ⏯, когато свирят няколко приложения, и изберете едно с F7, F8 или F9. Задръжте ⏯, за да спрете всичко на пауза."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když hraje víc aplikací, stiskněte ⏯ a vyberte jednu klávesou F7, F8 nebo F9. Podržením ⏯ pozastavíte vše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på ⏯, når flere apps spiller, og vælg én med F7, F8 eller F9. Hold ⏯ nede for at sætte alt på pause."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke ⏯, wenn mehrere Apps spielen, und wähle eine mit F7, F8 oder F9. Halte ⏯ gedrückt, um alles zu pausieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ⏯ cuando suene más de una app y elige una con F7, F8 o F9. Mantén pulsado ⏯ para pausarlo todo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui mängib mitu rakendust, vajuta ⏯ ja vali üks klahviga F7, F8 või F9. Hoia ⏯ all, et kõik peatada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina ⏯, kun useampi appi soittaa, ja valitse yksi näppäimellä F7, F8 tai F9. Pidä ⏯ painettuna keskeyttääksesi kaiken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur ⏯ quand plusieurs apps jouent, puis choisissez-en une avec F7, F8 ou F9. Maintenez ⏯ pour tout mettre en pause."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब एक से ज़्यादा ऐप चल रहे हों, तो ⏯ दबाएँ और F7, F8 या F9 से एक चुनें। सब कुछ रोकने के लिए ⏯ दबाकर रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pritisnite ⏯ kad svira više aplikacija i odaberite jednu tipkom F7, F8 ili F9. Držite ⏯ da sve pauzirate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomd meg a ⏯ gombot, ha több app is szól, majd válassz egyet az F7, F8 vagy F9 billentyűvel. Tartsd lenyomva a ⏯ gombot, hogy mindent szüneteltess."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi ⏯ quando più app sono in riproduzione e scegline una con F7, F8 o F9. Tieni premuto ⏯ per mettere tutto in pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のアプリが再生中のときは ⏯ を押し、F7・F8・F9 でひとつを選びます。⏯ を長押しするとすべて一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 앱이 재생 중일 때 ⏯를 누르고 F7, F8, F9로 하나를 고르세요. ⏯를 길게 누르면 모두 일시 정지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på ⏯ når flere apper spiller, og velg én med F7, F8 eller F9. Hold inne ⏯ for å sette alt på pause."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk op ⏯ als er meer dan één app speelt en kies er een met F7, F8 of F9. Houd ⏯ ingedrukt om alles te pauzeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy gra więcej niż jedna aplikacja, naciśnij ⏯ i wybierz jedną klawiszem F7, F8 lub F9. Przytrzymaj ⏯, aby wszystko wstrzymać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione ⏯ quando mais de um app estiver tocando e escolha um com F7, F8 ou F9. Mantenha ⏯ pressionado para pausar tudo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima ⏯ quando mais do que uma app estiver a tocar e escolha uma com F7, F8 ou F9. Mantenha ⏯ premido para pausar tudo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apasă ⏯ când rulează mai multe aplicații, apoi alege una cu F7, F8 sau F9. Ține apăsat ⏯ ca să pui totul pe pauză."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда играет несколько приложений, нажмите ⏯ и выберите одно клавишей F7, F8 или F9. Удерживайте ⏯, чтобы поставить всё на паузу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď hrá viac aplikácií, stlačte ⏯ a vyberte jednu klávesom F7, F8 alebo F9. Podržaním ⏯ pozastavíte všetko."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ⏯ när flera appar spelar och välj en med F7, F8 eller F9. Håll ned ⏯ för att pausa allt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla uygulama çalarken ⏯ tuşuna basın, sonra F7, F8 veya F9 ile birini seçin. Her şeyi duraklatmak için ⏯ tuşunu basılı tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли грає кілька застосунків, натисніть ⏯ і виберіть один клавішею F7, F8 або F9. Утримуйте ⏯, щоб поставити все на паузу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn ⏯ khi có nhiều ứng dụng đang phát, rồi chọn một ứng dụng bằng F7, F8 hoặc F9. Giữ ⏯ để tạm dừng tất cả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多个 App 同时播放时按 ⏯，再用 F7、F8 或 F9 选一个。按住 ⏯ 可全部暂停。"
          }
        }
      }
    },
