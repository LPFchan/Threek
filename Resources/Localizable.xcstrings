    "When more than one app is playing, ⏯ shows each one over the F-key that picks it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تشغيل أكثر من تطبيق، يعرض ⏯ كل تطبيق فوق مفتاح F الذي يختاره."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Когато свирят няколко приложения, ⏯ показва всяко над F клавиша, който го избира."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když hraje víc aplikací, ⏯ zobrazí každou nad klávesou F, která ji vybere."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når flere apps spiller, viser ⏯ hver af dem over den F-tast, der vælger den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn mehrere Apps spielen, zeigt ⏯ jede über der F-Taste, die sie auswählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando suena más de una app, ⏯ muestra cada una sobre la tecla F que la elige."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui mängib mitu rakendust, näitab ⏯ igaüht selle F-klahvi kohal, mis selle valib."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun useampi appi soittaa, ⏯ näyttää jokaisen sen valitsevan F-näppäimen yläpuolella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand plusieurs apps jouent, ⏯ affiche chacune au-dessus de la touche F qui la choisit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब एक से ज़्यादा ऐप चल रहे हों, तो ⏯ हर ऐप को उसे चुनने वाली F-कुंजी के ऊपर दिखाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad svira više aplikacija, ⏯ prikazuje svaku iznad F-tipke koja je odabire."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha több app is szól, a ⏯ mindegyiket az őt kiválasztó F-billentyű fölött mutatja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando più app sono in riproduzione, ⏯ mostra ciascuna sopra il tasto F che la sceglie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のアプリが再生中のときは、⏯ を押すと各アプリが対応する F キーの上に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 앱이 재생 중일 때 ⏯를 누르면 각 앱이 선택할 F 키 위에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når flere apper spiller, viser ⏯ hver av dem over F-tasten som velger den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als er meer dan één app speelt, toont ⏯ elke app boven de F-toets waarmee je hem kiest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy gra więcej niż jedna aplikacja, ⏯ pokazuje każdą nad klawiszem F, który ją wybiera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando mais de um app está tocando, ⏯ mostra cada um sobre a tecla F que o escolhe."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando mais do que uma app está a tocar, ⏯ mostra cada uma sobre a tecla F que a escolhe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când rulează mai multe aplicații, ⏯ afișează fiecare deasupra tastei F care o alege."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда играет несколько приложений, ⏯ показывает каждое над F-клавишей, которая его выбирает."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď hrá viac aplikácií, ⏯ zobrazí každú nad klávesom F, ktorý ju vyberie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När flera appar spelar visar ⏯ var och en ovanför F-tangenten som väljer den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla uygulama çalarken ⏯, her birini onu seçen F tuşunun üzerinde gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли грає кілька застосунків, ⏯ показує кожен над F-клавішею, що його обирає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi có nhiều ứng dụng đang phát, ⏯ hiển thị từng ứng dụng phía trên phím F để chọn nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多个 App 同时播放时，按 ⏯ 会把每个 App 显示在选中它的 F 键上方。"
          }
        }
      }
    },
